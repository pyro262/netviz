# Copy to docker-compose.override.yml (gitignored) for anything specific to
# your host. Compose merges it into docker-compose.yml automatically.
services:
  netviz-collector:
    volumes:
      # Discord webhook, read at call time. Never copy the secret into .env.
      - /path/to/watchtower/.env:/host/watchtower.env:ro
    networks:
      - my_influx_network

networks:
  my_influx_network:
    external: true
