# Copy to .env (chmod 600) and fill in. .env is gitignored -- never commit it.

# InfluxDB write token, scoped to the netviz bucket alone.
INFLUX_TOKEN=

# MaxMind GeoLite2 credentials, used only by tools/refresh_geoip.sh.
# Free account: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --------------------------------------------------------------- highlights --
# Up to three networks drawn in their own color on the globe -- a server VLAN,
# an IoT segment, a guest network. Matched as an address prefix against either
# end of a flow; KEEP THE TRAILING DOT, or '10.0.5' would also claim 10.0.50.x.
#
# These live here rather than in netviz/static/js/config.js because that file
# is tracked by git and an address prefix describes how your LAN is laid out.
# Leave a prefix empty and that slot is simply off.
#
# Colors are deliberately off the plasma ramp so a highlighted network reads
# as a separate system rather than as busier traffic. GAIN trims brightness:
# cyan and green clear the bloom threshold sooner than violet does.
# Extra public resolvers to keep off the display, comma separated. The built-in
# list already covers Cloudflare, Google, Quad9, OpenDNS, AdGuard, NextDNS and
# others; add your ISP's or your resolver's upstream here. An entry ending in
# "." or ":" is a prefix, so "45.90.28." matches the whole range.
NETVIZ_EXTRA_RESOLVERS=

# This site's own public WAN address(es), comma separated. Each entry is an
# address or a CIDR, v4 or v6.
#
# A router that blocks INBOUND traffic logs the far end as the source and its
# own WAN address as the destination, and the renderer reads the destination
# first. If your WAN address is really routable -- no carrier NAT in front of
# it -- it geolocates like any other host and every inbound block lands on
# your own ISP's country instead of the attacker's. Naming it here maps it to
# home like any private address and the real source is drawn instead.
#
# Behind double NAT the WAN address is RFC 1918 already and this is not
# needed. Leave empty and nothing changes.
#
# A DHCP WAN address changes; this is read fresh on every start, so refresh it
# from a script and restart the container. Watch /stats.json's geoip.home_ip:
# set but stuck at zero means the value went stale.
# tools/refresh_home_ip.sh is the refresher: from cron, it rewrites this line
# and recreates the container only when the address has actually changed.
NETVIZ_HOME_IPS=

# Watch a GitHub repo for newer releases and show a dim "UPDATE AVAILABLE"
# watermark in the kiosk's lower left when one exists.
#
# ON by default, pointing at upstream: one unauthenticated GET to GitHub every
# six hours, sending nothing about your network. Leave this line commented out
# to keep it. Set it to empty to disable the check entirely and make no
# outbound request at all:
#     NETVIZ_UPDATE_REPO=
# Or point it at your own fork:
#     NETVIZ_UPDATE_REPO=you/netviz

NETVIZ_HIGHLIGHT1_PREFIX=
NETVIZ_HIGHLIGHT1_LABEL=network 1
NETVIZ_HIGHLIGHT1_COLOR=#a855f7
NETVIZ_HIGHLIGHT1_GAIN=0.70
NETVIZ_HIGHLIGHT2_PREFIX=
NETVIZ_HIGHLIGHT2_LABEL=network 2
NETVIZ_HIGHLIGHT2_COLOR=#22d3ee
NETVIZ_HIGHLIGHT2_GAIN=0.51
NETVIZ_HIGHLIGHT3_PREFIX=
NETVIZ_HIGHLIGHT3_LABEL=network 3
NETVIZ_HIGHLIGHT3_COLOR=#4ade80
NETVIZ_HIGHLIGHT3_GAIN=0.55
